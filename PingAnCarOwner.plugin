#!name = 平安好车主签到与积分任务
#!desc = 被动保存平安好车主 App 的原请求，并按设定时间仅重放仍在有效期内的完整请求。不会推算、生成或改写 App 的认证信息；模板过期时直接停止。
#!author = Codex
#!homepage = https://github.com/XXJJz/loon-pingan-carowner
#!icon=https://raw.githubusercontent.com/XXJJz/loon-pingan-carowner/main/assets/pingan-carowner.jpg
#!date = 2026-08-14
#!system = iOS
#!loon_version = 3.2.1(733)
#!tag = 签到,积分,平安好车主

[Argument]
cron = input,"10 9 * * *",tag=执行时间,desc=五段 cron 表达式，默认每天 09:10
maxReplayAge = input,"120",tag=模板有效秒数,desc=只重放不超过该秒数的原请求；建议 30–120，过期会停止且不会联网
captureEnable = switch,true,tag=启用凭据抓取,desc=关闭后不会更新 Cookie、Token 和原请求模板

[Script]
http-request ^https:\/\/hcz-member\.pingan\.com\.cn\/micro-api\/(?:activity-sign|activity-points-zone)\/gw\/(?:signCall|taskCall)\/(?:mainv1|toSign|taskMine|finish|reward|rewardBatch|refreshRecommend)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/XXJJz/loon-pingan-carowner/main/pingan_carowner.js?v=1.0.6,requires-body=true,timeout=15,enable={captureEnable},tag=平安好车主原请求抓取
cron {cron} script-path=https://raw.githubusercontent.com/XXJJz/loon-pingan-carowner/main/pingan_carowner.js?v=1.0.6,timeout=60,argument=[{maxReplayAge}],enable=true,tag=平安好车主新鲜请求重放

[MITM]
hostname = hcz-member.pingan.com.cn
